DB_NAME=arete
DB_PORT=5432
DB_USERNAME=arete
DB_PASSWORD=arete
DB_URL=jdbc:postgresql://localhost:5432/arete

JWT_SECRET=
GOOGLE_CLIENT_ID=

# Comma-separated texts (hosts, names) that imported program templates must not contain
PROGRAM_TEMPLATE_BLOCKED_TERMS=
# The program template catalog: one subfolder per template (the folder name is the template's name), holding one
# day file per date (see src/main/resources/api/program-template-day-file.schema.json). Defaults to ./dev/catalog in
# the dev profile and ./catalog otherwise; leave it commented out to keep the default, because an empty value means
# the working directory
# PROGRAM_TEMPLATE_CATALOG_DIRECTORY=/absolute/path/to/catalog

# Whether this instance polls the import job queue, and how long it waits between polls
IMPORT_JOB_POLLING_ENABLED=true
IMPORT_JOB_POLL_INTERVAL=5s
